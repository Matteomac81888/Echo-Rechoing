<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout per una singola riga nella modalità KARAOKE.
    Root cliccabile → HorizontalScrollView per scroll orizzontale fluido
    → LinearLayout orizzontale che contiene le TextView delle parole (create dinamicamente).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="6dp">

    <HorizontalScrollView
        android:id="@+id/wordsScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:fadingEdgeLength="32dp"
        android:requiresFadingEdge="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="6dp"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/wordsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical" />

    </HorizontalScrollView>

</LinearLayout>